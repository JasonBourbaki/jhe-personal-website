---
import Citation from "@/components/Citation.astro";
import FeaturedCard from "@/components/FeaturedCard.astro";
import MentionItem from "@/components/MentionItem.astro";
import SocialList from "@/components/SocialList.astro";
import { getFeaturedWritings } from "@/data/featured";
import { getAllMentions, getAllWritings } from "@/data/writings";
import PageLayout from "@/layouts/Base.astro";

const MAX_WRITINGS = 7;
const MAX_MENTIONS = 5;

const latestWritings = (await getAllWritings()).slice(0, MAX_WRITINGS);
const latestMentions = (await getAllMentions()).slice(0, MAX_MENTIONS);
const featuredCards = await getFeaturedWritings();
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<h1 class="title mb-2">Jiaxin (Jason) He</h1>
		<p class="text-accent mb-6 font-semibold">Research Assistant, Economic Innovation Group</p>
		<p class="mb-4">
			I work on economic dynamism research, focusing on industrial policy, high-skilled immigration,
			trade in high-tech goods, and the labor market impact of artificial intelligence. My other
			interests include defense technology, supply-side housing reforms, and Sino-U.S. strategic
			competition. I graduated from Yale in 2024 with a double major in economics and history.
		</p>
		<SocialList />
	</section>
	<section class="mt-16">
		<h2 class="title mb-6 text-xl">Featured</h2>
		<div class="grid gap-6 sm:grid-cols-2">
			{
				featuredCards.map(({ image, imageAlt, writing }) => (
					<FeaturedCard image={image} imageAlt={imageAlt} writing={writing} />
				))
			}
		</div>
	</section>
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl">
			<a href="/writings/">Writings and Projects</a>
		</h2>
		<ul class="space-y-4" role="list">
			{
				latestWritings.map((writing) => (
					<li>
						<Citation writing={writing} />
					</li>
				))
			}
		</ul>
		<p class="mt-6">
			<a class="cactus-link text-accent font-semibold" href="/writings/">View all &rarr;</a>
		</p>
	</section>
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl">
			<a href="/media/">Media Mentions</a>
		</h2>
		<ul class="space-y-4" role="list">
			{
				latestMentions.map((mention) => (
					<li>
						<MentionItem mention={mention} />
					</li>
				))
			}
		</ul>
		<p class="mt-6">
			<a class="cactus-link text-accent font-semibold" href="/media/">View all &rarr;</a>
		</p>
	</section>
</PageLayout>
